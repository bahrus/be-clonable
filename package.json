{
  "name": "be-clonable",
  "version": "0.0.26",
  "keywords": [
    "web-components",
    "web-component",
    "custom-element",
    "custom-elements",
    "clone",
    "enhancement"
  ],
  "description": "Adds a button to any element that allows the element to be cloned.",
  "main": "be-clonable.js",
  "module": "be-clonable.js",
  "exports": {
    ".": "./be-clonable.js",
    "./be-clonable.js": "./be-clonable.js",
    "./emc.js": "./emc.js",
    "./⿻.js": "./⿻.js"
  },
  "files": [
    "*.js",
    "types.d.ts"
  ],
  "types": "types.d.ts",
  "scripts": {
    "build": "node emc.mjs > emc.json && node ⿻.mjs > ⿻.json",
    "serve": "node ./node_modules/spa-ssi/serve.js",
    "test": "playwright test",
    "safari": "npx playwright wk http://localhost:8000",
    "update": "ncu -u && npm install"
  },
  "dependencies": {
    "be-hive": "0.1.10",
    "mount-observer": "0.1.26",
    "roundabout-lib": "0.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "spa-ssi": "0.0.27"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahrus/be-clonable.git"
  },
  "author": "anderson.bruce.b@gmail.com",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bahrus/be-clonable/issues"
  },
  "homepage": "https://github.com/bahrus/be-clonable#readme"
}
